TELEGRAM_TOKEN=123456789:ABC-your-token-here
TELEGRAM_ADMIN_IDS=123456789

# Optional: Mini App is tunneled automatically (Cloudflare quick tunnel, no domain).
# Quick tunnels get a new *.trycloudflare.com URL every boot.
# For a stable Mini App URL, create a named tunnel in Cloudflare Zero Trust,
# route a hostname to http://127.0.0.1:8787, then set both of these:
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
# WEBAPP_URL=https://embedify.example.com
#
# WEBAPP_URL without a tunnel token means you already terminate HTTPS yourself.
# WEBAPP_TUNNEL=0
# WEBAPP_PORT=8787
# WEBAPP_HOST=127.0.0.1

# Optional
# DATABASE_PATH=./data/embedify.db
# DROP_PENDING_UPDATES=0
